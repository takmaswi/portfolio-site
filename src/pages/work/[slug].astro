---
import Layout from "../../layouts/Layout.astro";
import { enquiryUrl } from "../../content/contact";
import { projects, type Project } from "../../content/projects";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<Layout
  title={`${project.title} | Takunda Maswi`}
  description={project.summary}
>
  <main id="main" class="inner-page">
    <header class="page-intro">
      <a href="/work/" class="text-link">All work</a>
      <p class="eyebrow">{project.category}</p>
      <h1 class="display-title">{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <p class="eyebrow"><span aria-hidden="true">◉</span> {project.status}</p>
    </header>
    <figure class="detail-hero">
      <img
        src={project.image}
        alt={project.imageAlt}
        width="1440"
        height="900"
        fetchpriority="high"
      />
      <figcaption>Captured from the implemented interface.</figcaption>
    </figure>
    <div class="reading-grid">
      <section class="prose" aria-labelledby="project-context">
        <h2 id="project-context">The work</h2>
        {project.description.map((paragraph) => <p>{paragraph}</p>)}
        <h2>My contribution</h2>
        <ul>{project.contribution.map((item) => <li>{item}</li>)}</ul>
      </section>
      <aside class="facts" aria-label="Project details">
        <h2>Built with</h2>
        <p>{project.stack.join(", ")}</p>
        <h2>Current scope</h2>
        <p>{project.boundary}</p>
        {
          project.url && (
            <a class="text-link" href={project.url}>
              Visit the demo <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </aside>
    </div>
    <a href={enquiryUrl("project", project.title)} class="action-button"
      >Discuss a project like this <span aria-hidden="true">↗</span></a
    >
  </main>
</Layout>
