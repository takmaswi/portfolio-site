---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../content/projects";
---

<Layout
  title="Selected work | Takunda Maswi"
  description="Software products and client interfaces by Takunda Maswi."
>
  <main id="main" class="inner-page">
    <header class="page-intro">
      <p class="eyebrow">Selected work</p>
      <h1 class="display-title">Ideas, made usable.</h1>
      <p class="lead">
        A closer look at the software I build, the decisions behind it, and
        where the work stands.
      </p>
    </header>
    <div class="project-index">
      {
        projects.map((project, index) => (
          <article class="project-row">
            <a
              href={`/work/${project.slug}/`}
              class="project-cover"
              aria-label={`Explore ${project.title}`}
            >
              <img
                src={project.image}
                alt={project.imageAlt}
                loading="lazy"
                width="1440"
                height="900"
              />
            </a>
            <div>
              <p class="eyebrow">
                {String(index + 1).padStart(2, "0")} / {project.category}
              </p>
              <h2>
                <a href={`/work/${project.slug}/`}>{project.title}</a>
              </h2>
              <p>{project.summary}</p>
              <p class="eyebrow">
                <span aria-hidden="true">◉</span> {project.status}
              </p>
              <a class="text-link" href={`/work/${project.slug}/`}>
                Inside the project <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Layout>
