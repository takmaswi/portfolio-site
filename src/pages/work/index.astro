---
import Layout from "../../layouts/Layout.astro";
import "../../styles/work.css";
import { enquiryUrl } from "../../content/contact";
import {
  audiences,
  searchReady,
  systemsFor,
} from "../../content/work";
---

<Layout
  title="Work | Takunda Maswi"
  description="Payroll, HR, compliance, research, retail and personal finance systems built by Takunda Maswi for companies, small businesses and individuals."
>
  <main id="main" class="inner-page work-page">
    <header class="page-intro">
      <p class="eyebrow">Work</p>
      <h1 class="display-title">Systems that do the work.</h1>
      <p class="lead">
        A website should bring customers in and give them a reason to come
        back. Company software should know the rules the business answers to.
        This is what I have built, grouped by who uses it.
      </p>
      <p class="work-note">
        Client names stay private, and some of these are still being built, so
        most entries show the work itself rather than links.
      </p>
    </header>

    <section class="search-ready" aria-labelledby="search-ready-heading">
      <div>
        <p class="eyebrow">{searchReady.eyebrow}</p>
        <h2 id="search-ready-heading">{searchReady.heading}</h2>
        <p>{searchReady.body}</p>
      </div>
      <ul>
        {searchReady.points.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <nav class="audience-nav" aria-label="Work by audience">
      {
        audiences.map((audience, index) => (
          <a href={`#${audience.id}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {audience.label}
          </a>
        ))
      }
    </nav>

    {
      audiences.map((audience, index) => (
        <section
          class="audience"
          id={audience.id}
          aria-labelledby={`${audience.id}-heading`}
        >
          <header class="audience-head">
            <p class="eyebrow">
              {String(index + 1).padStart(2, "0")} / {audience.label}
            </p>
            <h2 id={`${audience.id}-heading`}>{audience.heading}</h2>
            <p>{audience.intro}</p>
          </header>
          <div class="system-grid">
            {systemsFor(audience.id).map((system) => (
              <article
                class:list={["system-card", { "is-text": !system.image }]}
                id={system.slug}
              >
                {system.image && (
                  <figure class="system-media">
                    <img
                      src={system.image}
                      alt={system.imageAlt}
                      width="1600"
                      height="1000"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                )}
                <div class="system-body">
                  <p class="eyebrow">{system.sector}</p>
                  <h3>
                    {system.title}
                    {system.subtitle && [
                      " ",
                      <span class="system-subtitle">{system.subtitle}</span>,
                    ]}
                  </h3>
                  <p class="system-summary">{system.summary}</p>
                  <ul>
                    {system.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                  {system.url && (
                    <a class="text-link system-link" href={system.url}>
                      Open {system.title} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
          {audience.alsoBuilt.length > 0 && (
            <div class="also-built">
              <p class="eyebrow">Also built</p>
              <ul>
                {audience.alsoBuilt.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))
    }

    <section class="work-close" aria-labelledby="work-close-heading">
      <h2 id="work-close-heading">Need something like this?</h2>
      <p>
        Tell me what the business needs to do better. I will tell you what I
        would build and how long it takes.
      </p>
      <a href={enquiryUrl("project")} class="action-button"
        >Discuss my project <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
</Layout>
