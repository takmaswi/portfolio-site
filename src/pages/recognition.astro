---
import Layout from "../layouts/Layout.astro";
import { recognition } from "../content/recognition";
---

<Layout
  title="Recognition & credentials | Takunda Maswi"
  description="Professional learning and recognition supporting Takunda Maswi's work in software and AI."
>
  <main id="main" class="inner-page">
    <header class="page-intro">
      <p class="eyebrow">Credentials</p><h1 class="display-title">
        Learning behind<br />the work.
      </h1><p class="lead">
        A record of professional learning that supports my practice.
      </p>
    </header>
    <div class="recognition-list">
      {
        recognition.map((item) => (
          <article>
            <p class="eyebrow">
              {item.issuer} · {item.date}
            </p>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            {item.url && (
              <a class="text-link" href={item.url}>
                View credential record <span aria-hidden="true">↗</span>
              </a>
            )}
            {item.courses && (
              <div class="credential-courses">
                <h3>Courses completed</h3>
                <ul>
                  {item.courses.map((course) => (
                    <li>{course}</li>
                  ))}
                </ul>
              </div>
            )}
            {item.documentUrl && (
              <a class="text-link" href={item.documentUrl}>
                Open certificate PDF <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <a class="text-link" href="/work/"
      >See the work <span aria-hidden="true">↗</span></a
    >
  </main>
</Layout>
